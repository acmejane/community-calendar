<style id='tribe-events-pro-views-v2-full-inline-css' class='tec-customizer-inline-style' type='text/css'>
:root {
				/* Customizer-added Global Event styles */
				--tec-font-family-sans-serif: inherit;
--tec-font-family-base: inherit;
--tec-color-text-events-title: #212529;
--tec-color-text-event-title: #212529;
--tec-color-text-event-date: #212529;
--tec-color-text-secondary-event-date: #212529;
--tec-color-link-primary: #004975;
--tec-color-link-accent: #004975;
--tec-color-link-accent-hover: rgba(0,73,117, 0.8);
--tec-color-accent-primary: #004975;
--tec-color-accent-primary-hover: rgba(0,73,117,0.8);
--tec-color-accent-primary-multiday: rgba(0,73,117,0.24);
--tec-color-accent-primary-multiday-hover: rgba(0,73,117,0.34);
--tec-color-accent-primary-active: rgba(0,73,117,0.9);
--tec-color-accent-primary-background: rgba(0,73,117,0.07);
--tec-color-background-secondary-datepicker: rgba(0,73,117,0.5);
--tec-color-accent-primary-background-datepicker: #004975;
--tec-color-button-primary: #004975;
--tec-color-button-primary-hover: rgba(0,73,117,0.8);
--tec-color-button-primary-active: rgba(0,73,117,0.9);
--tec-color-button-primary-background: rgba(0,73,117,0.07);
--tec-color-day-marker-current-month: #004975;
--tec-color-day-marker-current-month-hover: rgba(0,73,117,0.8);
--tec-color-day-marker-current-month-active: rgba(0,73,117,0.9);
--tec-color-background-primary-multiday: rgba(0,73,117, 0.24);
--tec-color-background-primary-multiday-hover: rgba(0,73,117, 0.34);
--tec-color-background-primary-multiday-active: rgba(0,73,117, 0.34);
--tec-color-background-secondary-multiday: rgba(0,73,117, 0.24);
--tec-color-background-secondary-multiday-hover: rgba(0,73,117, 0.34);
			}:root {
				/* Customizer-added Events Bar styles */
				--tec-color-text-events-bar-input: #212529;
--tec-color-text-events-bar-input-placeholder: #212529;
--tec-opacity-events-bar-input-placeholder: 0.6;
--tec-color-text-view-selector-list-item: #212529;
--tec-color-text-view-selector-list-item-hover: #212529;
--tec-color-background-view-selector-list-item-hover: rgba(33,37,41, 0.12);
--tec-color-background-events-bar-submit-button: #004975;
--tec-color-background-events-bar-submit-button-hover: rgba(0,73,117, 0.8);
--tec-color-background-events-bar-submit-button-active: rgba(0,73,117, 0.9);
			}:root {
				/* Customizer-added Month View styles */
				--tec-color-border-active-month-grid-hover: #212529;
--tec-color-day-marker-month: #212529;
--tec-color-day-marker-past-month: #212529;
			}
</style>
